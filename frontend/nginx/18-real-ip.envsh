#!/bin/sh
# IP thật của client khi `web` đứng sau load balancer / reverse proxy khác.
#
# REAL_IP_FROM: các CIDR (hoặc IP) của proxy đứng trước, cách nhau bằng dấu cách hoặc dấu phẩy.
# Rỗng (mặc định): NGINX_REAL_IP rỗng, $remote_addr là IP kết nối tới nginx như cũ.
# Có giá trị: NGINX_REAL_IP là một dòng `set_real_ip_from <mỗi CIDR>; real_ip_header
# X-Forwarded-For; real_ip_recursive on;`, 20-envsubst-on-templates.sh thay vào khối `server` của
# default.conf.template. nginx đọc X-Forwarded-For từ phải sang trái, bỏ qua địa chỉ thuộc
# REAL_IP_FROM, lấy địa chỉ đầu tiên không tin cậy làm $remote_addr: giá trị client tự đặt nằm bên
# trái địa chỉ proxy ghi thêm nên không được dùng (trừ khi tin cả mạng của client).
#
# File .envsh được entrypoint của image nginx *source* (không chạy riêng) trước khi thay template,
# nên biến export ở đây tới được envsubst. Entrypoint chạy với `set -eu` (không dùng biến chưa đặt);
# giá trị sai thì `exit 1`: container dừng thay vì chạy với cấu hình khác ý.

jc_real_ip=""
if [ -n "${REAL_IP_FROM:-}" ]; then
    set -f  # không mở rộng `*` trong giá trị thành tên file
    for jc_cidr in $(printf '%s' "$REAL_IP_FROM" | tr ',' ' '); do
        case "$jc_cidr" in
            *[!0-9A-Fa-f:./]*)
                echo "18-real-ip.envsh: REAL_IP_FROM chứa '$jc_cidr', không phải IP/CIDR" >&2
                exit 1
                ;;
        esac
        jc_real_ip="${jc_real_ip}set_real_ip_from ${jc_cidr}; "
    done
    set +f
    if [ -n "$jc_real_ip" ]; then
        jc_real_ip="${jc_real_ip}real_ip_header X-Forwarded-For; real_ip_recursive on;"
        [ -n "${NGINX_ENTRYPOINT_QUIET_LOGS:-}" ] ||
            echo "18-real-ip.envsh: tin X-Forwarded-For từ: $(printf '%s' "$REAL_IP_FROM" | tr ',' ' ')"
    fi
fi

NGINX_REAL_IP="$jc_real_ip"
export NGINX_REAL_IP
unset jc_real_ip jc_cidr
