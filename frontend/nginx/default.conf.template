# Giao diện jobcrawler: phục vụ bản build Vite (/usr/share/nginx/html) và chuyển /api/ tới backend.
#
# Template của image nginx chính thức: lúc khởi động, envsubst thay ${API_UPSTREAM},
# ${NGINX_LOCAL_RESOLVERS} và NGINX_REAL_IP (chỉ ba biến này: NGINX_ENVSUBST_FILTER trong
# Dockerfile) rồi ghi ra /etc/nginx/conf.d/default.conf, được include trong khối `http` của
# nginx.conf. Biến của nginx (chữ thường, vd. $uri) giữ nguyên. envsubst thay cả trong chú thích.

# Cache-Control theo đường dẫn. Đặt bằng một `add_header` ở mức server: location nào có
# `add_header` riêng thì bỏ hết `add_header` của server (không cộng dồn), mất luôn header bảo mật.
# - /assets/: tên file có hash nội dung → cache một năm, không hỏi lại.
# - /api/: backend tự quyết (giá trị rỗng = không thêm header).
# - còn lại (index.html, favicon...): luôn hỏi lại để bản build mới có hiệu lực ngay.
map $uri $jc_cache_control {
    default     "no-cache";
    ~^/assets/  "public, max-age=31536000, immutable";
    ~^/api/     "";
}

# Log truy cập kèm thời gian xử lý và X-Request-Id backend trả về (tra log của backend theo id).
log_format jc_web '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
                  '"$http_referer" "$http_user_agent" rt=$request_time '
                  'urt=$upstream_response_time rid=$upstream_http_x_request_id';

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # IP thật của client sau load balancer (REAL_IP_FROM, nginx/18-real-ip.envsh): rỗng khi không
    # đặt; có thì là set_real_ip_from + real_ip_header X-Forwarded-For + real_ip_recursive on, và
    # $remote_addr (log, X-Forwarded-For gửi API) là IP client thay vì IP của proxy đứng trước.
    ${NGINX_REAL_IP}

    server_tokens off;
    # Chuyển hướng dùng đường dẫn tương đối: cổng ngoài host (vd. 8000) khác cổng trong container.
    absolute_redirect off;

    access_log /var/log/nginx/access.log jc_web;

    # Không có `always`: chỉ gắn vào 2xx/3xx, nên 404 của /assets/ không bị cache một năm.
    add_header Cache-Control $jc_cache_control;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    # text/html luôn được nén; JSON của API cũng nén ở đây (backend không tự nén).
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;

    # DNS lúc chạy (resolver lấy từ /etc/resolv.conf của container: 127.0.0.11 trong mạng compose)
    # thay vì một lần lúc khởi động: backend tạo lại (IP mới) không làm nginx gọi nhầm IP cũ, và nginx
    # vẫn khởi động được khi backend chưa có tên trong DNS (/healthz không phụ thuộc backend).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    resolver_timeout 5s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        # proxy_pass với biến: tên máy được phân giải lúc chạy; URI của request gửi nguyên vẹn
        # (API_UPSTREAM chỉ gồm scheme://host:port, không có đường dẫn).
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Giữ nguyên Host (kèm cổng) của trình duyệt: backend chặn request ghi có Origin khác Host
        # (chống CSRF), nên Host phải là địa chỉ người dùng mở, không phải backend:8000.
        proxy_set_header Host $http_host;
        # Ghi đè (không nối thêm): backend tin X-Forwarded-For từ mọi IP và uvicorn lấy giá trị đầu
        # tiên, nên nối thêm thì client tự đặt được IP giả để né giới hạn đăng nhập sai theo IP.
        # Sau load balancer (REAL_IP_FROM), $remote_addr đã là IP client nginx rút ra từ
        # X-Forwarded-For của proxy tin cậy; ngoài ra là IP kết nối tới nginx.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Request id của client (nếu có) đi tiếp; X-Request-Id backend trả về cũng tới client.
        proxy_set_header X-Request-Id $http_x_request_id;

        # Không chặn lỗi của backend (proxy_intercept_errors mặc định off): 401 kèm
        # WWW-Authenticate (HTTP Basic khi backend đặt UI_PASSWORD) tới thẳng trình duyệt.
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # Nhập CSV (doanh nghiệp, golden set).
        client_max_body_size 50m;
        client_body_buffer_size 1m;

        # Đệm đủ cho header + trang JSON thường gặp trong RAM, ít phải ghi file tạm.
        proxy_buffer_size 16k;
        proxy_buffers 32 16k;
        proxy_busy_buffers_size 64k;
    }

    # Cập nhật trực tiếp (Server-Sent Events, `GET /api/events`): kết nối giữ lâu, mỗi sự kiện phải
    # tới trình duyệt ngay. Không đệm, không nén (gzip đệm cả khối); backend gửi `: ping` mỗi 15 giây
    # nên timeout đọc chỉ cần dài hơn thế — để 1 giờ cho thoáng. Header như `location /api/`.
    location = /api/events {
        set $api_upstream "${API_UPSTREAM}";
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $http_x_request_id;

        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 1h;
        proxy_read_timeout 1h;
    }

    # File của bản build (tên có hash). Thiếu file thì 404, không trả index.html: trình duyệt giữ
    # bản build cũ xin chunk đã xoá nhận lỗi rõ ràng (giao diện nhận ra: src/lib/chunk-error.ts).
    location ^~ /assets/ {
        access_log off;
        try_files $uri =404;
    }

    # Router phía trình duyệt: đường dẫn không phải file tĩnh trả index.html.
    location / {
        try_files $uri /index.html;
    }
}
