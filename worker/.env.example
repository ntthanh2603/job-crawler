# Cấu hình worker lấy trang (jobworker). Sao chép thành worker/.env rồi điền: worker đọc `.env` ở
# thư mục chạy (worker/). Biến của môi trường thắng file; dòng để trống = dùng mặc định. Bảng đầy
# đủ: README.md. Docker / compose truyền biến qua `environment` / `env_file`, không đọc file này.

# --- Gateway gRPC của backend ----------------------------------------------------------------
# host:port. Compose cùng máy: backend:50051; máy khác: host:cổng giao diện của máy backend
# (gRPC đi qua nginx của frontend, vd. crawler.example.com:443 + GATEWAY_TLS=true).
GATEWAY_ADDR=localhost:50051
# Xác thực (khi backend đặt GATEWAY_TOKEN): worker vào lần đầu bằng một khoá tham gia, nhận token
# riêng, mọi lời gọi sau dùng token đó (`jobworker/services/credentials.py`). Khoá tham gia, thử
# lần lượt:
# - WORKER_JOIN_KEY: khoá dùng một lần tạo ở trang Workers → "Thêm worker" (hết hạn sau 15 phút);
# - GATEWAY_TOKEN: khoá cố định, giống GATEWAY_TOKEN của backend (worker trong hạ tầng của mình).
GATEWAY_TOKEN=
WORKER_JOIN_KEY=
# Nơi lưu token riêng (giữ qua lần khởi động lại; trống = ~/.jobworker/token). Worker chỉ có khoá
# một lần thì mount volume vào đây, không thì tạo lại container là phải xin khoá mới. Mỗi process
# một file: token gắn với WORKER_ID của process vừa đăng ký bằng nó, dùng chung thì các process
# giành token của nhau.
# WORKER_TOKEN_FILE=/data/jobworker-token
# Kết nối TLS (gateway có GATEWAY_TLS_CERT/KEY hoặc đứng sau reverse proxy HTTP/2 có TLS).
GATEWAY_TLS=false
# File PEM của CA riêng (chứng chỉ tự ký / CA nội bộ); trống = bộ CA công khai đóng kèm grpcio
# (không đọc kho CA của hệ điều hành: CA nội bộ cài vào máy cũng phải trỏ biến này tới file PEM).
GATEWAY_CA_CERT=

# --- Worker --------------------------------------------------------------------------------------
# Id duy nhất mỗi process; để trống = `<hostname>-<8 hex>`, sinh mới mỗi lần khởi động. Không đặt
# chung một giá trị cho nhiều process. Chỉ A-Z a-z 0-9 _ . : @ -, tối đa 128 ký tự.
WORKER_ID=
# Nhóm worker; backend định tuyến domain → pool bằng FETCH_ROUTES. Chỉ A-Z a-z 0-9 _ . -, tối đa 64
# ký tự.
WORKER_POOL=default
# Số request HTTP / trang Chromium cùng lúc tối đa (như WORKER_MAX_CONCURRENCY của open-asm; backend
# không ghi đè). Trống = tự tính theo CPU / RAM của máy (cgroup của container): HTTP 8 / CPU trong
# [8, 64]; render 1 mỗi 768 MiB RAM, không quá số CPU, trong [1, 8]. Đặt số thì dùng số đó.
WORKER_HTTP_SLOTS=
# 0 = worker không mở Chromium (chỉ nhận việc HTTP).
WORKER_RENDER_SLOTS=
# Fingerprint curl_cffi.
WORKER_IMPERSONATE=chrome
# Nhãn tự do, JSON, hiện ở trang Workers: WORKER_LABELS={"region": "hn", "provider": "x"}
WORKER_LABELS={}
# Body lớn hơn thì trả ERROR_KIND_TOO_LARGE (không kèm body).
WORKER_MAX_BODY_BYTES=10485760
# SIGTERM / Ctrl-C: chờ việc đang chạy tối đa chừng này giây rồi mới thoát.
WORKER_SHUTDOWN_GRACE_SECONDS=30

# --- Proxy riêng của máy (backend PROXY_MODE=worker) ----------------------------------------
# Để trống: worker dùng danh sách proxy chung gateway gửi xuống (bảng proxy ở trang Cài đặt).
# Đặt thì máy này dùng proxy của nó thay cho danh sách chung.
# Mỗi dòng một proxy, định dạng như config/proxies.example.txt (đường dẫn tính từ worker/).
WORKER_PROXIES_FILE=config/worker-proxies.txt
# Hoặc liệt kê thẳng: JSON list hoặc cách nhau bởi dấu phẩy.
WORKER_PROXIES=
# Giữ một proxy cho mỗi domain chừng này giây; proxy nghỉ với domain sau lỗi kết nối / 403 / 407 /
# 429 chừng này giây.
WORKER_PROXY_STICKY_SECONDS=600
WORKER_PROXY_COOLDOWN_SECONDS=120

# --- Healthcheck ---------------------------------------------------------------------------------
# File trạng thái worker ghi (sau mỗi lời gọi gateway và mỗi nhịp heartbeat) cho `jobworker health`
# (healthcheck của Docker). Trống = thư mục tạm của hệ thống: /tmp/jobworker-health.json trong
# container. Chạy nhiều worker trên cùng một máy (không container) thì đặt mỗi process một file.
WORKER_HEALTH_FILE=
# Watchdog: event loop hoặc vòng heartbeat đứng quá chừng này giây thì worker thoát mã 70 để Docker
# (`restart: unless-stopped`) chạy lại. Mất gateway không tính. 0 = tắt; khác 0 thì ít nhất 10.
WORKER_WATCHDOG_SECONDS=120

# --- Secret --------------------------------------------------------------------------------------
# Thư mục secret: mỗi file một biến, tên file là tên biến viết thường hoặc hoa (gateway_token,
# worker_proxies...). Trống = /run/secrets nếu có (Docker / compose `secrets:`), không có thì không
# đọc. Biến môi trường và .env thắng file secret. Đặt mà thư mục không tồn tại: worker không chạy.
SECRETS_DIR=

# --- Log -----------------------------------------------------------------------------------------
# DEBUG in từng việc (worker.task_done).
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
