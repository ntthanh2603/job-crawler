# Cấu hình service backend (`jobcrawler serve`: API, gateway, scheduler, runner) — CHỈ những gì cần
# để khởi động: kết nối Postgres / Redis, gateway cho worker, đăng nhập, log. Sao chép thành
# backend/.env rồi điền: lệnh `jobcrawler` đọc `.env` trong thư mục đang chạy (backend/), compose
# nạp file này cho container `backend`. Biến môi trường thắng `.env`.
#
# Mọi cài đặt khác (lịch thu thập, runner, worker, proxy, mạng, nguồn, trang tuyển dụng, LLM, SERP,
# KYC, bảo trì) đặt ở trang Cài đặt và lưu trong DB (bảng `app_settings`). Vẫn đặt được bằng biến
# cùng tên ở đây (vd. LLM_BASE_URL=...): trang Cài đặt hiện chúng và có nút lưu vào DB; giá trị lưu
# ở trang Cài đặt luôn thắng.

# --- Bí mật từ file (Docker / compose secrets) ----------------------------------
# Mỗi file một giá trị, tên file = tên biến viết thường: gateway_token, llm_api_key, serp_api_key,
# ui_password, database_url... (nội dung bỏ khoảng trắng / xuống dòng hai đầu).
# Ưu tiên: biến môi trường > .env > file bí mật > mặc định; biến đặt rỗng (`GATEWAY_TOKEN=`) bị bỏ
# qua nên file vẫn được dùng. Không đặt SECRETS_DIR thì dùng /run/secrets nếu thư mục đó tồn tại
# (chỗ compose gắn `secrets:`); đặt rỗng = tắt. Chỉ đọc từ biến môi trường của process (compose nạp
# file này làm env_file nên có tác dụng trong container; chạy trên máy thì export).
# SECRETS_DIR=/run/secrets

# --- Kết nối -------------------------------------------------------------------
# Mặc định khớp docker-compose.yaml ở gốc repo khi chạy CLI trên host (127.0.0.1, không localhost);
# compose ghi đè hai URL này bằng hostname nội bộ cho container.
DATABASE_URL=postgresql+asyncpg://jobcrawler:jobcrawler@127.0.0.1:15432/jobcrawler
# Redis chính: hàng đợi, stream lấy trang, worker, khoá, rate limit, phiên bản cài đặt, số đo SLA,
# chặn đoán mật khẩu, heartbeat health. Production: maxmemory-policy noeviction + lưu đĩa (AOF).
REDIS_URL=redis://127.0.0.1:16379/0
# Redis chỉ cho cache tính lại được (trang HTTP, robots.txt, tìm nguồn, SERP, câu trả lời LLM, số
# liệu trang Tổng quan): đặt riêng một Redis có maxmemory + allkeys-lru, không cần lưu đĩa. Trống =
# dùng chung REDIS_URL. Rate limit theo domain / LLM vẫn ở REDIS_URL (bị đẩy ra là gửi dồn tới
# site).
CACHE_REDIS_URL=
# Nâng cao (bỏ # để đổi): pool kết nối Postgres mỗi process, tiền tố khoá Redis, tên ba queue.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# REDIS_PREFIX=jc
# BUILD_QUEUE_NAME=jobcrawler-build
# POLL_QUEUE_NAME=jobcrawler-poll
# BOARD_QUEUE_NAME=jobcrawler-boards
# DB riêng cho `pytest -m integration` (schema bị xoá và dựng lại mỗi lần test).
TEST_DATABASE_URL=postgresql+asyncpg://jobcrawler:jobcrawler@127.0.0.1:15432/jobcrawler_test

# --- Gateway gRPC cho worker lấy trang ------------------------------------------
# Phía worker (GATEWAY_ADDR, WORKER_POOL, slot, proxy riêng) cấu hình ở worker/.env. Slot, định
# tuyến domain, cấu hình đẩy xuống worker: trang Cài đặt → Worker lấy trang.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=50051
# Worker phải gửi token này (bắt buộc khi gateway mở ra ngoài mạng nội bộ).
GATEWAY_TOKEN=
# TLS cho gateway (file PEM); trống = không mã hoá (đặt sau reverse proxy có TLS).
GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=

# --- Proxy chung (chỉ khi PROXY_MODE=central ở trang Cài đặt) ---------------------
# File danh sách proxy, tương đối với thư mục đang chạy (backend/; trong image: /src/backend), mẫu
# ở config/proxies.example.txt. Danh sách nhập ở trang Cài đặt được gộp thêm.
PROXIES_FILE=config/proxies.txt

# --- Nâng cao (bỏ # để đổi) ---------------------------------------------------
# Nhịp xếp lịch của scheduler (giây); số entry tối đa của stream việc lấy trang.
# SCHEDULER_TICK_SECONDS=1
# FETCH_STREAM_MAXLEN=100000

# --- Đăng nhập giao diện / API ------------------------------------------------
# Tài khoản của trang đăng nhập (phiên là JWT trong cookie httpOnly; script gọi API dùng
# `Authorization: Bearer <access_token>` của POST /api/auth/login). Để trống UI_PASSWORD = không
# hỏi đăng nhập (chỉ khi cổng chỉ mở ở 127.0.0.1). Sai 20 lần / 5 phút / IP thì bị chặn 5 phút.
UI_USERNAME=admin
UI_PASSWORD=
# Khoá ký JWT (chuỗi ngẫu nhiên dài, vd. `openssl rand -base64 48`). Trống = backend tự sinh một
# khoá lưu trên Redis (dùng chung các process; mất Redis thì mọi người đăng nhập lại). Đổi khoá /
# mật khẩu = mọi phiên cũ hết hiệu lực.
JWT_SECRET=
# Hạn một phiên đăng nhập (giờ).
AUTH_TOKEN_HOURS=12

# --- Mã hoá trường nhạy cảm trong DB -------------------------------------------
# Khoá API LLM / SERP và danh sách proxy (có mật khẩu) của trang Cài đặt lưu trong DB dạng mã hoá
# AES-256-GCM. Một hoặc nhiều chuỗi bí mật dài (vd. `openssl rand -base64 48`) cách nhau dấu phẩy:
# chuỗi CUỐI dùng để mã hoá, các chuỗi trước chỉ để giải mã — đổi khoá bằng cách thêm khoá mới vào
# cuối, khởi động lại backend (tự mã hoá lại) rồi mới bỏ khoá cũ. Trống = khoá tự sinh lưu trên
# Redis (mất Redis thì phải nhập lại các khoá API / proxy). Production: đặt, và sao lưu riêng.
ENCRYPTION_KEYS=
# SSO qua proxy tin cậy (oauth2-proxy đứng trước service giao diện): tên header chứa người dùng
# đã đăng nhập, vd. X-Auth-Request-User. Đặt thì API lấy người dùng từ header này (nhật ký thao
# tác ghi đúng người), không dùng trang đăng nhập; thiếu header → 401. CHỈ AN TOÀN khi cổng api không mở ra
# ngoài và mọi request đi qua oauth2-proxy (proxy ghi đè header): gọi thẳng được api thì ai cũng
# tự đặt header được. Trống = tắt.
AUTH_PROXY_USER_HEADER=
# Header email (vd. X-Auth-Request-Email): dùng khi header người dùng trống.
AUTH_PROXY_EMAIL_HEADER=
# Đường dẫn đăng xuất hiện ở giao diện (vd. /oauth2/sign_out); trống = không có nút đăng xuất.
AUTH_LOGOUT_URL=
# IP / mạng của reverse proxy (nginx của giao diện) được tin X-Forwarded-For, cách nhau dấu phẩy.
# uvicorn đọc từ biến môi trường của process (container nạp file này nên có tác dụng; chạy trên
# máy thì dùng `jobcrawler api --forwarded-allow-ips`). Trống = 127.0.0.1,::1.
# FORWARDED_ALLOW_IPS=

# --- Dữ liệu mẫu -------------------------------------------------------------
# `jobcrawler serve`: DB chưa có doanh nghiệp nào thì nạp 50 doanh nghiệp lớn của Việt Nam để thử
# ngay (giao diện → Doanh nghiệp → Nhập CSV cũng có nút nạp). Production: false.
DEMO_COMPANIES=true

# --- Watchdog -----------------------------------------------------------------
# api / gateway / scheduler / runner: event loop (hoặc vòng lặp chính của scheduler / một vai
# runner) đứng quá chừng này giây thì process tự thoát với mã 70, `jobcrawler serve` dừng cả
# container và Docker (`restart: unless-stopped`) dựng lại; log `watchdog.stall` cho biết cái gì đứng. Mất Postgres / Redis không
# làm thoát. 0 = tắt (vd. khi debug có breakpoint).
WATCHDOG_SECONDS=120

# --- Log ---------------------------------------------------------------------
LOG_LEVEL=INFO
# console | json (production: json)
LOG_FORMAT=console
# Mức log ghi vào bảng `logs` (trang lượt chạy). Production nên đặt WARNING: INFO ghi mọi bước
# của mọi lượt poll, bảng phình nhanh.
LOG_DB_LEVEL=INFO
