# Biến của docker-compose.yaml (5 container: postgres, redis, backend, frontend, worker) — cổng, số
# worker, tài khoản Postgres, image. Cấu hình của từng service nằm ở thư mục service: backend/.env (từ
# backend/.env.example), worker/.env (từ worker/.env.example). `task env` tạo cả ba file nếu chưa có.

# --- Postgres (container `postgres`) ---------------------------------------------------------------
# Đổi tài khoản thì sửa luôn DATABASE_URL / TEST_DATABASE_URL trong backend/.env (dùng khi chạy trên
# máy host); trong compose URL của backend được dựng lại từ các biến này.
POSTGRES_USER=jobcrawler
POSTGRES_PASSWORD=jobcrawler
POSTGRES_DB=jobcrawler

# --- Cổng mở ra máy host (chỉ 127.0.0.1) ----------------------------------------------------------
POSTGRES_PORT=15432
REDIS_PORT=16379
# Giao diện + API (container `frontend`).
WEB_PORT=8000
# Gateway gRPC cho worker ở máy khác: mở ra mạng thì đặt GATEWAY_TOKEN (backend/.env và worker/.env
# của máy worker) và TLS, xem docs/DEPLOY.md.
GATEWAY_PUBLISH=127.0.0.1:50051

# --- Load balancer / reverse proxy đứng trước `frontend` -------------------------------------------
# Chỉ CIDR / IP của load balancer ngoài cùng (cách nhau dấu phẩy hoặc dấu cách): nginx lấy IP thật
# của người dùng từ X-Forwarded-For do nó gửi. Load balancer phải GHI THÊM (append) IP client vào
# X-Forwarded-For, không chuyển nguyên giá trị client gửi. Trống = tắt (IP là IP kết nối tới nginx).
REAL_IP_FROM=

# --- Worker -----------------------------------------------------------------------------------------
# Số bản worker lấy trang.
WORKER_REPLICAS=1
# Máy chỉ chạy worker (`docker compose up -d --no-deps worker`): host:port gateway của máy backend.
# Trống = `backend:50051` (cùng máy).
WORKER_GATEWAY_ADDR=

# --- Image ------------------------------------------------------------------------------------------
# Trống = image build tại máy (`task up` / `docker compose up --build`). Dùng image CI đã đẩy lên
# GHCR (CI đẩy mỗi lần push main / tag vX.Y.Z): REGISTRY=ghcr.io/<owner>/ (có dấu / ở cuối) rồi
# `docker compose pull` (GHCR riêng tư: `docker login ghcr.io` trước).
REGISTRY=
# latest = bản build tại máy, hoặc bản phát hành mới nhất trên GHCR. Production ghim phiên bản:
# 1.4.0 (tag v1.4.0 của `task release`), hoặc main / sha-<7 ký tự> (bản build từ nhánh main).
IMAGE_TAG=latest
