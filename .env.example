# Sao chép thành .env rồi điền. Dòng để trống = dùng mặc định / tắt tính năng đó.

# --- Kết nối (backend) ---------------------------------------------------------
# Mặc định khớp docker-compose.yaml khi chạy CLI trên host; container tự dùng hostname nội bộ.
DATABASE_URL=postgresql+asyncpg://jobcrawler:jobcrawler@127.0.0.1:15432/jobcrawler
REDIS_URL=redis://127.0.0.1:16379/0
# DB riêng cho `pytest -m integration` (schema bị xoá và dựng lại mỗi lần test).
TEST_DATABASE_URL=postgresql+asyncpg://jobcrawler:jobcrawler@127.0.0.1:15432/jobcrawler_test

# --- Docker Compose ----------------------------------------------------------
POSTGRES_PORT=15432
REDIS_PORT=16379
API_PORT=8000
# Cổng gateway gRPC mở ra máy host (worker ở máy khác: 0.0.0.0:50051 + GATEWAY_TOKEN).
GATEWAY_PUBLISH=127.0.0.1:50051
RUNNER_POLL_REPLICAS=2
RUNNER_BUILD_REPLICAS=2
RUNNER_BOARDS_REPLICAS=1
WORKER_REPLICAS=2

# --- LLM: vLLM self-host chạy Qwen (API tương thích OpenAI) --------------------
# Ví dụ dạng: http://<host>:8000/v1 — để trống thì các bước dùng LLM bị tắt.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DISABLE_THINKING=true
LLM_MAX_CONCURRENCY=8
LLM_MAX_INPUT_CHARS=20000
# Giới hạn request/phút của endpoint LLM, dùng chung mọi worker qua Redis (để trống =
# không giới hạn). Đặt thấp hơn giới hạn server; vượt thì server trả 429.
LLM_REQUESTS_PER_MINUTE=

# --- SERP --------------------------------------------------------------------
# serper | brave. Thiếu key thì bỏ qua các bước dùng SERP (có cảnh báo).
SERP_PROVIDER=serper
SERP_API_KEY=
SERP_RESULTS=10
SERP_RATE_PER_SECOND=5
# Cache kết quả tìm kiếm (giây) để chạy lại không tốn credit.
SERP_CACHE_SECONDS=2592000

# --- KYC doanh nghiệp ----------------------------------------------------------
# Kết quả KYC (companies.kyc_at) dùng lại trong chừng này ngày.
KYC_CACHE_DAYS=30
# Ngưỡng pg_trgm khi tra cache theo tên gần giống (chỉ khớp doanh nghiệp đã verified).
KYC_TRIGRAM_THRESHOLD=0.7
# LLM phải chắc ít nhất mức này (kèm bằng chứng khớp mạnh) mới đánh verified.
KYC_MIN_CONFIDENCE=0.8
# Giây tối đa cho KYC mỗi lượt (SERP + đọc website + LLM); số website ứng viên được mở.
KYC_TIMEOUT_SECONDS=45
KYC_MAX_SITES=3

# --- Lịch thu thập: build bộ khung ban đêm, poll tin mới ban ngày -------------------------
# Khung giờ HH:MM-HH:MM theo CRAWL_TIMEZONE (qua nửa đêm được, vd. 22:00-05:00).
CRAWL_TIMEZONE=Asia/Ho_Chi_Minh
BUILD_WINDOW=00:00-06:00
POLL_WINDOW=06:00-24:00
# Chu kỳ poll mỗi doanh nghiệp (giây): P95 độ trễ phát hiện tin mới ≈ chu kỳ + một lượt poll.
POLL_INTERVAL_SECONDS=150
POLL_JITTER_SECONDS=10
POLL_DEADLINE_SECONDS=60
POLL_TIMEOUT_SECONDS=90
# Lỗi tạm liên tiếp chừng này lượt poll thì build lại bộ khung; poll lỗi thì build lại ngay.
POLL_MAX_FAILURES=3
REBUILD_ON_ERROR=true
# Build đêm tìm lại nguồn trên website (không dùng cache tìm nguồn).
BUILD_REFRESH_DISCOVERY=true
SCHEDULER_TICK_SECONDS=1
SCHEDULER_BATCH=500
BUILD_QUEUE_MAX_BACKLOG=2000
POLL_QUEUE_MAX_BACKLOG=5000

# --- Lượt build (đủ) ------------------------------------------------------------
# Deadline mềm (huỷ nguồn chưa xong, lưu `partial`) và timeout cứng của job, tính bằng giây.
COMPANY_DEADLINE_SECONDS=165
COMPANY_TIMEOUT_SECONDS=180
# Số lần chạy tối đa một job build (runner chết / quá timeout cứng thì chạy lại).
COMPANY_JOB_RETRIES=2
# Lượt partial (chạm giới hạn, hết giờ, tin chờ LLM): tự chạy tiếp tối đa N lần, sau X giây.
COMPANY_MAX_CONTINUATIONS=2
COMPANY_CONTINUATION_DELAY_SECONDS=60

# --- Gateway gRPC + worker lấy trang (phía backend) ---------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=50051
# Worker phải gửi token này (bắt buộc khi gateway mở ra ngoài mạng nội bộ).
GATEWAY_TOKEN=
# TLS cho gateway (file PEM); trống = không mã hoá (đặt sau reverse proxy có TLS).
GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=
# Định tuyến domain → pool worker, JSON: FETCH_ROUTES={"topcv.vn": "residential"}
FETCH_ROUTES={}
FETCH_QUEUE_GRACE_SECONDS=30
# Hàng việc đông nhưng vẫn chạy: chờ thêm từng khung, tổng tối đa timeout + chừng này giây
# (phải lớn hơn FETCH_QUEUE_GRACE_SECONDS).
FETCH_QUEUE_MAX_WAIT_SECONDS=300
# Cấu hình đẩy xuống mọi worker (0 = giữ cấu hình của từng worker).
GATEWAY_HTTP_SLOTS=0
GATEWAY_RENDER_SLOTS=0
GATEWAY_WORKER_TTL_SECONDS=30

# --- Proxy -------------------------------------------------------------------
# worker = mỗi worker dùng proxy của mình (WORKER_PROXIES / WORKER_PROXIES_FILE ở dưới);
# central = backend chọn proxy từ danh sách chung (PROXIES_FILE + trang Cài đặt);
# off = không proxy (CLI: jobcrawler --no-proxy ...).
PROXY_MODE=worker
PROXIES_FILE=config/proxies.txt

# --- Worker lấy trang (jobworker; đọc cùng file .env khi chạy trên cùng máy) ------------
GATEWAY_ADDR=localhost:50051
WORKER_POOL=default
WORKER_HTTP_SLOTS=32
# 0 = worker không mở Chromium (chỉ nhận việc HTTP).
WORKER_RENDER_SLOTS=2
# Proxy riêng của worker (mỗi dòng một proxy, xem config/proxies.example.txt).
WORKER_PROXIES_FILE=config/worker-proxies.txt

# --- Runner: số job chạy cùng lúc mỗi process ------------------------------------------
RUNNER_BUILD_CONCURRENCY=10
RUNNER_POLL_CONCURRENCY=50
RUNNER_BOARD_CONCURRENCY=4

# --- Hàng đợi, bảo trì, nén ---------------------------------------------------
# Job của runner không báo sống chừng này giây thì runner khác thu hồi và chạy lại.
QUEUE_RECLAIM_SECONDS=60
# Cron bảo trì: lượt chạy treo → failed, xoá dữ liệu cũ, huấn luyện từ điển nén (db maintain).
MAINTENANCE_CRON=17 * * * *
# Cron tính số liệu phân bố cho trang Tổng quan (lưu Redis, người xem không phải chờ).
OVERVIEW_CRON=*/5 * * * *
SOURCE_FETCH_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30
FAILED_PAGE_RETENTION_DAYS=7
# Trang parse lỗi lưu HTML (nén) tối đa mỗi lượt.
FAILED_PAGES_PER_RUN=20
# Nén zstd + từ điển cho job_postings.raw, mô tả job, HTML trang lỗi.
COMPRESSION_LEVEL=9
COMPRESSION_DICT_SIZE=65536
COMPRESSION_DICT_MIN_SAMPLES=1000
COMPRESSION_DICT_MAX_SAMPLES=5000
# Từ điển mới chỉ dùng sau chừng này giây (> chu kỳ làm mới) để mọi worker kịp nạp.
COMPRESSION_DICT_DELAY_SECONDS=900
COMPRESSION_DICT_REFRESH_SECONDS=300
COMPRESSION_DICT_RETRAIN_DAYS=30
# Số dòng tối đa nén lại bằng từ điển mới mỗi lượt bảo trì.
COMPRESSION_RECOMPRESS_ROWS=50000

# --- Nguồn từ website doanh nghiệp (trang careers, ATS) ---------------------------
# Cache kết quả tìm trang careers/ATS (giây); không tìm thấy thì cache ngắn hơn.
DISCOVERY_CACHE_SECONDS=604800
DISCOVERY_NEGATIVE_CACHE_SECONDS=86400
# Thời gian tối đa cho bước tìm nguồn mỗi lượt (giây), phần còn lại để thu thập.
DISCOVERY_TIMEOUT_SECONDS=60
# Giới hạn mỗi nguồn: số tin, trang chi tiết, trang danh sách, trang mở bằng trình duyệt.
SOURCE_MAX_JOBS=500
SOURCE_MAX_DETAIL_PAGES=80
SOURCE_MAX_LISTING_PAGES=10
SOURCE_MAX_RENDERED_PAGES=10
# Trang danh mục / theo tỉnh của trang careers (dẫn tới tin), mỗi nguồn.
SOURCE_MAX_SUB_LISTINGS=60
# Trang của API danh sách tin mà trang careers SPA gọi (đọc tiếp page / offset), mỗi nguồn.
SOURCE_MAX_API_PAGES=20
# Tin website/ATS đã tải chi tiết trong chừng này ngày thì dùng lại (0 = luôn tải lại).
JOB_REUSE_DAYS=3
# Request/giây tới API công khai của ATS (Greenhouse, Lever...); ghi đè từng host bằng RATE_LIMITS.
ATS_RATE_PER_SECOND=2

# --- Index trang tuyển dụng (runner --role boards, jobcrawler index-boards) ------------------
# Trang chạy, JSON (rỗng = mọi adapter đang bật): BOARDS='["topcv","itviec"]'.
BOARDS=[]
# Index đủ (ban đêm): mỗi lượt mỗi trang tối đa chừng này giây / tin (phần còn lại để lượt sau).
BOARD_INDEX_CRON=30 0 * * *
BOARD_INDEX_BUDGET_SECONDS=14400
BOARD_MAX_JOBS_PER_RUN=20000
# Index đuôi (ban ngày): chỉ phần mới nhất của danh sách, rồi poll ngay doanh nghiệp có tin mới.
BOARD_TAIL_CRON=*/2 6-23 * * *
BOARD_TAIL_BUDGET_SECONDS=90
BOARD_TAIL_MAX_JOBS=300
# Tải lại tin không đổi lastmod sau chừng này ngày (kèm ETag/Last-Modified).
BOARD_REFRESH_DAYS=7
BOARD_CONCURRENCY=4
# Lượt build: index của profile cũ hơn chừng này giờ thì đọc trực tiếp trang profile (poll
# ban ngày không bao giờ gọi trang tuyển dụng theo từng doanh nghiệp).
BOARD_STALE_HOURS=24
# Map profile ↔ doanh nghiệp: ngưỡng trigram để xét, độ tin cậy tối thiểu để nhận.
PROFILE_MATCH_TRIGRAM=0.6
PROFILE_MATCH_MIN_CONFIDENCE=0.8
# KYC không tìm thấy website: vẫn dùng profile có tên trùng hẳn tên doanh nghiệp (đủ riêng).
BOARD_NAME_PROFILES_WITHOUT_KYC=true
# Doanh nghiệp chưa có profile trên một trang: tìm bằng SERP site: (cần SERP_API_KEY).
BOARD_SERP_LOOKUP=true
BOARD_SERP_LOOKUP_SECONDS=20
# Sau mỗi lượt index: poll ngay doanh nghiệp có profile vừa có tin mới.
BOARD_POLL_COMPANIES=true

# --- Chuẩn hoá, xác minh, gộp ------------------------------------------------
# Tin còn nghi ngờ phải được LLM chấm ít nhất mức này mới nhận.
VERIFY_MIN_CONFIDENCE=0.8
# JD (mô tả + yêu cầu) ngắn hơn chừng này ký tự thì loại (EMPTY_JD).
VERIFY_MIN_JD_CHARS=200
# Tin trên trang tuyển dụng không có hạn nộp, đăng quá chừng này ngày thì coi là hết hạn.
VERIFY_BOARD_MAX_AGE_DAYS=180
# Số tin tối đa mỗi doanh nghiệp được hỏi LLM: chấm tin nghi ngờ / phân loại trường mơ hồ.
VERIFY_LLM_MAX_JOBS=40
NORMALIZE_LLM_MAX_JOBS=40

# --- Tầng mạng ---------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
# Số lần retry (429, 5xx, timeout) với backoff + jitter.
HTTP_MAX_RETRIES=3
HTTP_CACHE_TTL_SECONDS=3600
# Mặc định cho mọi domain; ghi đè theo domain bằng JSON.
RATE_LIMIT_PER_SECOND=1
RATE_LIMITS={}
ROBOTS_CACHE_SECONDS=86400
PROXY_STICKY_SECONDS=1800
PROXY_COOLDOWN_SECONDS=300
PROXY_MAX_CONSECUTIVE_FAILURES=5
PROXY_CHECK_URL=https://www.cloudflare.com/cdn-cgi/trace

# --- Giao diện web (jobcrawler ui, service api) --------------------------------
# Để trống UI_PASSWORD = không hỏi đăng nhập (compose chỉ mở cổng ở 127.0.0.1).
UI_USERNAME=admin
UI_PASSWORD=
API_PORT=8000

# --- Log ---------------------------------------------------------------------
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
LOG_DB_LEVEL=INFO
