# Biến của docker-compose.yaml (một máy) — chỉ cổng, số bản, tài khoản Postgres. Cấu hình của
# từng service nằm ở thư mục service: backend/.env (từ backend/.env.example), worker/.env (từ
# worker/.env.example). `task env` tạo cả ba file nếu chưa có.

# --- Postgres (container `postgres`) ---------------------------------------------------------------
# Đổi tài khoản thì sửa luôn DATABASE_URL / TEST_DATABASE_URL trong backend/.env (dùng khi chạy trên
# máy host); trong compose URL của backend được dựng lại từ các biến này.
POSTGRES_USER=jobcrawler
POSTGRES_PASSWORD=jobcrawler
POSTGRES_DB=jobcrawler

# --- Cổng mở ra máy host (chỉ 127.0.0.1) ----------------------------------------------------------
POSTGRES_PORT=15432
REDIS_PORT=16379
# Giao diện + API (service `web`).
WEB_PORT=8000
# Gateway gRPC cho worker ở máy khác: mở ra mạng thì đặt GATEWAY_TOKEN (backend/.env và worker/.env
# của máy worker) và TLS, xem docs/DEPLOY.md.
GATEWAY_PUBLISH=127.0.0.1:50051

# --- Số bản mỗi service ----------------------------------------------------------------------------
RUNNER_POLL_REPLICAS=2
RUNNER_BUILD_REPLICAS=2
RUNNER_BOARDS_REPLICAS=1
WORKER_REPLICAS=2
